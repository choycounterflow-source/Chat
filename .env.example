# Core Render Docker Runtime Variables (Pre-filled defaults)
NODE_ENV="production"
PORT="10000"
HOST="0.0.0.0"
DISABLE_HMR="true"

# App & Admin Metadata
APP_NAME="Choy Chat"
APP_VERSION="2.5.0"
APP_URL="https://choy-chat.onrender.com"
ADMIN_EMAIL="choyjiez07@gmail.com"
PWA_THEME_COLOR="#022c22"
CACHE_MODE="lightweight-auto"

# Storage Profile
STORAGE_PROVIDER="Google One 5TB"
STORAGE_QUOTA_GB="5120"
SUPABASE_BUCKET="choychat-media"

# Optional Secret Keys (Set in Render Dashboard -> Environment if used)
GEMINI_API_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
