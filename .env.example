# Core Render Docker Runtime Variables (Pre-filled defaults)
NODE_ENV="production"
PORT="10000"
HOST="0.0.0.0"
DISABLE_HMR="true"

# App & Admin Metadata
APP_NAME="Choy Chat"
APP_VERSION="2.6.0"
APP_URL="https://chat-9-si9x.onrender.com"
PWA_THEME_COLOR="#022c22"
CACHE_MODE="lightweight-auto"

# Cloud Database (Render PostgreSQL Internal/External URL OR Supabase Postgres URI)
DATABASE_URL=

# Optional Admin Override Credentials (If unset, first user claims Admin via setup form)
ADMIN_PHONE=
ADMIN_PIN=

# Optional Secret Keys (Set in Render Dashboard -> Environment if used)
GEMINI_API_KEY=

# Supabase Storage (1GB Free Media Bucket for Photos, Videos up to 25MB, Voice Notes)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET="choychat-media"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
