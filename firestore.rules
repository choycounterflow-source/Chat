rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }
    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'choyjiez07@gmail.com';
    }
    function isAdmin() {
      return isBootstrappedAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Validation Blueprints (Anti-Update-Gap: used on BOTH create and update)
    function isValidPublicUser(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'status', 'visibility', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'status', 'visibility', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.status in ['pending', 'approved']
        && data.visibility == 'public'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateUserInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'blockedUsers', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'blockedUsers', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && data.blockedUsers is list && data.blockedUsers.size() <= 100
        && (data.blockedUsers.size() == 0 || (data.blockedUsers[0] is string && data.blockedUsers[0].size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'authorHandle', 'authorAvatar', 'content', 'mediaType', 'category', 'visibility', 'createdAt'])
        && data.keys().hasOnly(['authorId', 'authorName', 'authorHandle', 'authorAvatar', 'content', 'mediaUrl', 'mediaType', 'category', 'visibility', 'createdAt'])
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorHandle is string && data.authorHandle.size() >= 1 && data.authorHandle.size() <= 80
        && data.authorAvatar is string && data.authorAvatar.size() <= 500
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 2000
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 1000))
        && data.mediaType in ['text', 'image', 'video']
        && data.category in ['feed', 'myday', 'video']
        && data.visibility == 'public'
        && data.createdAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'roomId', 'text', 'mediaType', 'reactions', 'visibility', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['senderId', 'senderName', 'roomId', 'text', 'mediaUrl', 'mediaType', 'reactions', 'visibility', 'createdAt', 'updatedAt'])
        && data.senderId is string && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.roomId in ['VIP Group', 'Choy Admin', 'Maria Santos']
        && data.text is string && data.text.size() <= 2000
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 1000))
        && data.mediaType in ['text', 'image', 'video', 'audio', 'file']
        && data.reactions is list && data.reactions.size() <= 20
        && (data.reactions.size() == 0 || (data.reactions[0] is string && data.reactions[0].size() <= 16))
        && data.visibility == 'members'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLedgerRow(data) {
      return data.keys().hasAll(['name', 'fiveH', 'fiveHType', 'bulig', 'point5', 'halfSack', 'oneSack', 'bal', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'fiveH', 'fiveHType', 'bulig', 'point5', 'halfSack', 'oneSack', 'bal', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.fiveH is number && data.fiveH >= -1000000 && data.fiveH <= 1000000
        && data.fiveHType in ['blue', 'red']
        && data.bulig is number && data.bulig >= -1000000 && data.bulig <= 1000000
        && data.point5 is number && data.point5 >= -1000000 && data.point5 <= 1000000
        && data.halfSack is number && data.halfSack >= -1000000 && data.halfSack <= 1000000
        && data.oneSack is number && data.oneSack >= -1000000 && data.oneSack <= 1000000
        && data.bal is number && data.bal >= -100000000 && data.bal <= 100000000
        && data.updatedBy is string && isValidId(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidKnowledgeQA(data) {
      return data.keys().hasAll(['question', 'answer', 'visibility', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['question', 'answer', 'visibility', 'createdBy', 'createdAt'])
        && data.question is string && data.question.size() >= 1 && data.question.size() <= 300
        && data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 2000
        && data.visibility == 'public'
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp;
    }

    function isValidAdminSetting(data) {
      return data.keys().hasAll(['fiveH', 'bulig', 'point5', 'halfSack', 'oneSack', 'defFiveH', 'defBulig', 'defPoint5', 'defHalfSack', 'defOneSack', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['fiveH', 'bulig', 'point5', 'halfSack', 'oneSack', 'defFiveH', 'defBulig', 'defPoint5', 'defHalfSack', 'defOneSack', 'updatedBy', 'updatedAt'])
        && data.fiveH is number && data.fiveH >= 0 && data.fiveH <= 1000000
        && data.bulig is number && data.bulig >= 0 && data.bulig <= 1000000
        && data.point5 is number && data.point5 >= 0 && data.point5 <= 1000000
        && data.halfSack is number && data.halfSack >= 0 && data.halfSack <= 1000000
        && data.oneSack is number && data.oneSack >= 0 && data.oneSack <= 1000000
        && data.defFiveH is number && data.defFiveH >= 0 && data.defFiveH <= 1000000
        && data.defBulig is number && data.defBulig >= 0 && data.defBulig <= 1000000
        && data.defPoint5 is number && data.defPoint5 >= 0 && data.defPoint5 <= 1000000
        && data.defHalfSack is number && data.defHalfSack >= 0 && data.defHalfSack <= 1000000
        && data.defOneSack is number && data.defOneSack >= 0 && data.defOneSack <= 1000000
        && data.updatedBy is string && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['name', 'total', 'visibility', 'updatedAt'])
        && data.keys().hasOnly(['name', 'total', 'visibility', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.total is number && data.total >= -100000000 && data.total <= 100000000
        && data.visibility == 'public'
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.createdAt is timestamp;
    }

    function isValidCloudAccount(data, accountId) {
      return data.keys().hasAll(['accountId', 'name', 'phone', 'pinHash', 'role', 'status', 'blockedUsers', 'newsfeed', 'accountCreatedAt', 'accountUpdatedAt', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['accountId', 'name', 'phone', 'pinHash', 'role', 'status', 'blockedUsers', 'avatar', 'newsfeed', 'accountCreatedAt', 'accountUpdatedAt', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.accountId is string && data.accountId == accountId && isValidId(data.accountId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 64
        && data.pinHash is string && data.pinHash.size() >= 10 && data.pinHash.size() <= 256
        && data.role in ['admin', 'member']
        && data.status in ['pending', 'approved']
        && data.blockedUsers is list && data.blockedUsers.size() <= 100
        && (data.blockedUsers.size() == 0 || (data.blockedUsers[0] is string && data.blockedUsers[0].size() <= 80))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 200000))
        && data.newsfeed in ['feed_a', 'feed_b', 'feed_c', 'feed_bc']
        && data.accountCreatedAt is string && data.accountCreatedAt.size() >= 1 && data.accountCreatedAt.size() <= 64
        && data.accountUpdatedAt is string && data.accountUpdatedAt.size() >= 1 && data.accountUpdatedAt.size() <= 64
        && data.updatedBy is string && isValidId(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudNewsfeedConfig(data) {
      return data.keys().hasAll(['feedATitle', 'feedBTitle', 'feedCTitle', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['feedATitle', 'feedBTitle', 'feedCTitle', 'updatedBy', 'updatedAt'])
        && data.feedATitle is string && data.feedATitle.size() >= 1 && data.feedATitle.size() <= 80
        && data.feedBTitle is string && data.feedBTitle.size() >= 1 && data.feedBTitle.size() <= 80
        && data.feedCTitle is string && data.feedCTitle.size() >= 1 && data.feedCTitle.size() <= 80
        && data.updatedBy is string && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidCloudAnnouncement(data, annId) {
      return data.keys().hasAll(['annId', 'title', 'message', 'badge', 'tone', 'target', 'active', 'createdBy', 'annCreatedAt', 'annUpdatedAt', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['annId', 'title', 'message', 'badge', 'tone', 'target', 'active', 'createdBy', 'annCreatedAt', 'annUpdatedAt', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.annId is string && data.annId == annId && isValidId(data.annId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
        && data.badge in ['announcement', 'reminder', 'urgent']
        && data.tone in ['emerald', 'amber', 'sky', 'rose']
        && data.target in ['all', 'feed_a', 'feed_b', 'feed_c', 'feed_bc']
        && data.active is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 80
        && data.annCreatedAt is string && data.annCreatedAt.size() >= 1 && data.annCreatedAt.size() <= 64
        && data.annUpdatedAt is string && data.annUpdatedAt.size() >= 1 && data.annUpdatedAt.size() <= 64
        && data.updatedBy is string && isValidId(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 1. PUBLIC USER PROFILES (NO PII) + SPLIT PRIVATE SUBCOLLECTION
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin() || existing().visibility == 'public');
      allow list: if isVerified() && existing().visibility == 'public';
      allow create: if isVerified()
        && isValidId(userId)
        && isValidPublicUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().status == 'pending')
          || isAdmin()
        );
      allow update: if isVerified()
        && isValidId(userId)
        && isValidPublicUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'status', 'updatedAt']))
          || (isOwner(userId) && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(userId) && isAdmin();

      // Private PII subcollection gated by parent user document existence
      match /private/{docId} {
        allow get: if isVerified() && isValidId(userId) && isValidId(docId)
          && (isOwner(userId) || isAdmin());
        allow list: if isVerified() && (isOwner(userId) || isBootstrappedAdmin());
        allow create: if isVerified()
          && isValidId(userId) && docId == 'info'
          && isValidPrivateUserInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (isOwner(userId) || isAdmin());
        allow update: if isVerified()
          && isValidId(userId) && docId == 'info'
          && isValidPrivateUserInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'blockedUsers', 'updatedAt']))
            || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'blockedUsers', 'updatedAt']))
          );
        allow delete: if isVerified() && isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // 2. COMMUNITY NEWSFEED POSTS
    match /posts/{postId} {
      allow get: if isVerified() && isValidId(postId) && existing().visibility == 'public';
      allow list: if isVerified() && existing().visibility == 'public';
      allow create: if isVerified()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isVerified()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'mediaUrl', 'mediaType', 'category']))
          || (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'mediaUrl', 'mediaType', 'category']))
        );
      allow delete: if isVerified() && isValidId(postId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    // 3. REAL-TIME CHAT MESSAGES
    match /messages/{messageId} {
      allow get: if isVerified() && isValidId(messageId) && existing().visibility == 'members';
      allow list: if isVerified() && existing().visibility == 'members';
      allow create: if isVerified()
        && isValidId(messageId)
        && isValidMessage(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(messageId)
        && isValidMessage(incoming())
        && incoming().senderId == existing().senderId
        && incoming().roomId == existing().roomId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'updatedAt']))
          || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'reactions', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(messageId) && (existing().senderId == request.auth.uid || isAdmin());
    }

    // 4. ADMIN-ONLY MILESTONE SPREADSHEET LEDGER
    match /ledger/{rowId} {
      allow get: if isVerified() && isValidId(rowId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isVerified()
        && isValidId(rowId)
        && isValidLedgerRow(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(rowId)
        && isValidLedgerRow(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'fiveH', 'fiveHType', 'bulig', 'point5', 'halfSack', 'oneSack', 'bal', 'updatedBy', 'updatedAt'])
        && isAdmin();
      allow delete: if isVerified() && isValidId(rowId) && isAdmin();
    }

    // 5. CHOY AI BRAIN KNOWLEDGE Q&A (Admin writes, all verified users read)
    match /knowledge/{qaId} {
      allow get: if isVerified() && isValidId(qaId) && existing().visibility == 'public';
      allow list: if isVerified() && existing().visibility == 'public';
      allow create: if isVerified()
        && isValidId(qaId)
        && isValidKnowledgeQA(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(qaId)
        && isValidKnowledgeQA(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['question', 'answer'])
        && isAdmin();
      allow delete: if isVerified() && isValidId(qaId) && isAdmin();
    }

    // 6. ADMIN-ONLY SYNCED SETTINGS (Unit Prices & Default Quantities)
    match /settings/{settingId} {
      allow get: if isVerified() && isValidId(settingId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isVerified()
        && isValidId(settingId)
        && isValidAdminSetting(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(settingId)
        && isValidAdminSetting(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['fiveH', 'bulig', 'point5', 'halfSack', 'oneSack', 'defFiveH', 'defBulig', 'defPoint5', 'defHalfSack', 'defOneSack', 'updatedBy', 'updatedAt'])
        && isAdmin();
      allow delete: if isVerified() && isValidId(settingId) && isAdmin();
    }

    // 7. PUBLIC LEADERBOARD (NO PII - synced from admin ledger)
    match /leaderboard/{entryId} {
      allow get: if isVerified() && isValidId(entryId) && (isAdmin() || existing().visibility == 'public');
      allow list: if isVerified() && existing().visibility == 'public';
      allow create: if isVerified()
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming())
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'total', 'updatedAt'])
        && isAdmin();
      allow delete: if isVerified() && isValidId(entryId) && isAdmin();
    }

    // 8. ADMIN ROLE REGISTRY
    match /admins/{userId} {
      allow get: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerified()
        && isValidId(userId)
        && isValidAdminRecord(incoming(), userId)
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if false;
      allow delete: if isVerified() && isValidId(userId) && isBootstrappedAdmin();
    }

    // 9. ADMIN-ONLY CLOUD USER ACCOUNT VAULT
    match /cloud_accounts/{accountId} {
      allow get: if isVerified() && isValidId(accountId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isVerified()
        && isValidId(accountId)
        && isValidCloudAccount(incoming(), accountId)
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(accountId)
        && isValidCloudAccount(incoming(), accountId)
        && incoming().accountId == existing().accountId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'pinHash', 'role', 'status', 'blockedUsers', 'avatar', 'newsfeed', 'accountCreatedAt', 'accountUpdatedAt', 'updatedBy', 'updatedAt'])
        && isAdmin();
      allow delete: if isVerified() && isValidId(accountId) && isAdmin();
    }

    // 10. ADMIN-ONLY CLOUD NEWSFEED CONFIG BACKUP
    match /cloud_newsfeed_config/{docId} {
      allow get: if isVerified() && isValidId(docId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isVerified()
        && isValidId(docId)
        && isValidCloudNewsfeedConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(docId)
        && isValidCloudNewsfeedConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['feedATitle', 'feedBTitle', 'feedCTitle', 'updatedBy', 'updatedAt'])
        && isAdmin();
      allow delete: if isVerified() && isValidId(docId) && isAdmin();
    }

    // 11. ADMIN-ONLY CLOUD ANNOUNCEMENTS BACKUP
    match /cloud_announcements/{annId} {
      allow get: if isVerified() && isValidId(annId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isVerified()
        && isValidId(annId)
        && isValidCloudAnnouncement(incoming(), annId)
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(annId)
        && isValidCloudAnnouncement(incoming(), annId)
        && incoming().annId == existing().annId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'badge', 'tone', 'target', 'active', 'createdBy', 'annCreatedAt', 'annUpdatedAt', 'updatedBy', 'updatedAt'])
        && isAdmin();
      allow delete: if isVerified() && isValidId(annId) && isAdmin();
    }
  }
}
